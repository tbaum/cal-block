{
  "name": "@cal-block/desktop",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "node -e \"require('electron')\"",
    "dev": "electron-vite dev",
    "build": "tsc -p . && electron-vite build",
    "typecheck": "tsc -p .",
    "package": "electron-vite build && electron-builder --mac --arm64"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.2"
  },
  "devDependencies": {
    "@cal-block/core": "workspace:*",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "vite": "^8.3.6"
  },
  "description": "Mirrors busy time into a Google blocker calendar"
}
